    <string name="widget_stage_description">Płyta z kropek w pierścieniu korektora, z tytułem, postępem i sterowaniem.</string>
    <string name="widget_medium_description">Płyta z kropek, tytuł z kropek, korektor na żywo i sterowanie.</string>
    <string name="widget_small_description">Okładka jako płyta z kropek, z odtwarzaniem i pauzą.</string>
    <string name="widget_wide_description">Korektor z kropek na żywo, tytuł z kropek, odtwarzanie i następny.</string>
