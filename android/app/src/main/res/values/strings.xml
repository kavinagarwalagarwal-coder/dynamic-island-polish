    <string name="onb_meet_title">Meet your island</string>
    <string name="onb_meet_body">Your camera hole becomes a live island for music, calls, timers and messages. It grows out when something happens and slips back in when nothing does.</string>
    <string name="onb_tap_title">Tap to open</string>
    <string name="onb_tap_body">Tap the small island to jump straight into its app.</string>
    <string name="onb_hold_title">Hold to expand</string>
    <string name="onb_hold_body">Press and hold, or pull down, to open the full card with its controls.</string>
    <string name="onb_up_title">Swipe up to tuck it away</string>
    <string name="onb_up_body">Swipe up on an open card to shrink it back. Tapping outside the card works too.</string>
    <string name="onb_side_title">Two at once</string>
    <string name="onb_side_body">When two things are live, the second waits in a bubble. Swipe sideways to swap them, or hold the bubble to open it.</string>
    <string name="onb_volume_title">Volume, alarms and more</string>
    <string name="onb_volume_body">Volume keys, headphones, downloads and alarms get islands of their own. Switch each one on or off in Features.</string>
    <string name="onb_finish_title">Connect your island</string>
    <string name="onb_finish_body">Give Dynamic Droid notification access and the camera-area overlay, and your island comes to life.</string>
    <string name="onb_ready_title">You\'re all set</string>
    <string name="onb_ready_body">Your island is connected. Replay this tour any time from Playground.</string>

    <!-- Phone pop-ups -->
    <string name="feature_hide_popups">Hide the phone\'s pop-up notifications</string>
    <string name="feature_hide_popups_note">The island shows new notifications instead of the phone\'s banners and swipes each pop-up away as it appears. They still arrive in the notification shade. Pop-ups stay as usual whenever the island isn\'t running, during quiet hours, or in apps where the island is hidden.</string>
    <string name="popups_status_active">Active • the phone\'s pop-ups are hidden while the island runs</string>
    <string name="popups_status_waiting">On • pop-ups hide once the island and notification access are connected</string>
    <string name="popups_grant_button">Stop pop-ups completely (optional)</string>
    <string name="popups_grant_title">Stop pop-ups completely</string>
    <string name="popups_grant_body">This is optional. Without it, the island swipes each pop-up away a moment after it appears. With a one-time permission from a computer, Dynamic Droid can switch the phone\'s pop-ups off instead, so they never flash at all. Turn on USB debugging, connect your phone and run:\n\n%1$s\n\nTurn this option off before uninstalling Dynamic Droid so your pop-ups come back.</string>
    <string name="popups_status_swipe">On • the island swipes the phone\'s pop-ups away as they appear</string>
    <string name="popups_status_needs_access">Turn on Dynamic Droid in Accessibility settings so it can clear pop-ups</string>
    <string name="popups_copy">Copy command</string>
    <string name="popups_copied">Command copied</string>
