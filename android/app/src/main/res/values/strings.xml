    <string name="ringer_dnd_off">Do Not Disturb off</string>
    <string name="mode_ringer">Ring &amp; silent</string>
    <string name="demo_ringer">Silent</string>
    <string name="feature_ringer">Ring, vibrate &amp; silent</string>
    <string name="feature_ringer_note">Show the island when the phone switches between ring, vibrate and silent, or Do Not Disturb turns on or off.</string>
    <string name="feature_glow">Soft edge glow</string>
    <string name="feature_glow_note">A gentle glow around the pill so it stands out on dark wallpapers and apps. It brightens for a moment when something new arrives.</string>
    <string name="feature_ringer_controls">Ring &amp; silent buttons</string>
    <string name="feature_ringer_controls_note">Ring, Vibrate, Silent and Do Not Disturb buttons under the volume slider. Tapping the ring/silent island also switches to the next mode.</string>
    <string name="feature_full_width">Open islands fill the width</string>
    <string name="feature_full_width_note">Messages, volume and other opened islands stretch across the screen instead of growing from the camera.</string>
    <string name="ringer_needs_access">Allow Do Not Disturb access for Dynamic Droid to switch to Silent or Do Not Disturb</string>
    <string name="feature_art_backdrop">Album art behind the island</string>
    <string name="feature_art_backdrop_note">While a song plays, the island\'s background becomes its album cover, softly blurred and dimmed so text stays readable. Pausing fades it back to black.</string>
    <string name="feature_idle_pill">Keep the island when idle</string>
    <string name="feature_idle_pill_note">Leave a small black pill around the camera when nothing is happening, instead of disappearing into it.</string>
</resources>
