    <string name="onb_meet_title">Kenalan dengan pulau Anda</string>
    <string name="onb_meet_body">Lubang kamera Anda menjadi pulau hidup untuk musik, panggilan, timer, dan pesan. Pulau muncul saat ada sesuatu dan bersembunyi saat tidak ada apa-apa.</string>
    <string name="onb_tap_title">Ketuk untuk membuka</string>
    <string name="onb_tap_body">Ketuk pulau kecil untuk langsung masuk ke aplikasinya.</string>
    <string name="onb_hold_title">Tahan untuk membuka penuh</string>
    <string name="onb_hold_body">Tekan dan tahan, atau tarik ke bawah, untuk membuka kartu lengkap dengan kontrolnya.</string>
    <string name="onb_up_title">Geser ke atas untuk menyimpan</string>
    <string name="onb_up_body">Geser ke atas pada kartu yang terbuka untuk mengecilkannya. Mengetuk di luar kartu juga bisa.</string>
    <string name="onb_side_title">Dua sekaligus</string>
    <string name="onb_side_body">Saat ada dua hal aktif, yang kedua menunggu di gelembung. Geser ke samping untuk menukarnya, atau tahan gelembung untuk membukanya.</string>
    <string name="onb_volume_title">Volume, alarm, dan lainnya</string>
    <string name="onb_volume_body">Tombol volume, headphone, unduhan, dan alarm punya pulau sendiri. Nyalakan atau matikan masing-masing di Fitur.</string>
    <string name="onb_finish_title">Hubungkan pulau Anda</string>
    <string name="onb_finish_body">Beri Dynamic Droid akses notifikasi dan overlay area kamera, dan pulau Anda akan hidup.</string>
    <string name="onb_ready_title">Semua siap</string>
    <string name="onb_ready_body">Pulau Anda terhubung. Ulangi tur ini kapan saja dari Coba.</string>
    <string name="feature_hide_popups">Sembunyikan notifikasi pop-up ponsel</string>
    <string name="feature_hide_popups_note">Pulau menampilkan notifikasi baru sebagai ganti banner ponsel dan menyingkirkan setiap pop-up begitu muncul. Notifikasi tetap masuk ke panel notifikasi. Pop-up tetap seperti biasa saat pulau tidak berjalan, selama jam tenang, atau di aplikasi tempat pulau disembunyikan.</string>
    <string name="popups_status_active">Aktif • pop-up ponsel disembunyikan selama pulau berjalan</string>
    <string name="popups_status_waiting">Nyala • pop-up akan disembunyikan setelah pulau dan akses notifikasi terhubung</string>
    <string name="popups_grant_button">Hentikan pop-up sepenuhnya (opsional)</string>
    <string name="popups_grant_title">Hentikan pop-up sepenuhnya</string>
    <string name="popups_grant_body">Ini opsional. Tanpa ini, pulau menyingkirkan setiap pop-up sesaat setelah muncul. Dengan izin satu kali dari komputer, Dynamic Droid bisa mematikan pop-up ponsel sehingga tidak pernah muncul. Aktifkan debugging USB, hubungkan ponsel, lalu jalankan:\n\n%1$s\n\nMatikan opsi ini sebelum menghapus Dynamic Droid agar pop-up kembali.</string>
    <string name="popups_status_swipe">Nyala • pulau menyingkirkan pop-up ponsel begitu muncul</string>
    <string name="popups_status_needs_access">Nyalakan Dynamic Droid di setelan Aksesibilitas agar bisa menyingkirkan pop-up</string>
