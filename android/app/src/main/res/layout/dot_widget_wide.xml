<?xml version="1.0" encoding="utf-8"?>
<!-- 4×1: a live equaliser, the title in dots, play and next. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="6dp">

    <FrameLayout
        android:layout_width="34dp"
        android:layout_height="28dp">
        <ProgressBar
            android:id="@+id/eq"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/dot_eq" />
        <ImageView
            android:id="@+id/eq_still"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/dot_eq_still"
            android:visibility="gone" />
    </FrameLayout>

    <ImageView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:contentDescription="@string/widget_title"
        android:scaleType="fitStart" />

    <ImageButton
        android:id="@+id/play"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/action_play_pause"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_dot_play" />

    <ImageButton
        android:id="@+id/next"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/action_next"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_dot_next" />
</LinearLayout>
