    <string name="onb_meet_title">Conheça sua ilha</string>
    <string name="onb_meet_body">O furo da câmera vira uma ilha ao vivo para música, chamadas, timers e mensagens. Ela aparece quando algo acontece e se recolhe quando nada acontece.</string>
    <string name="onb_tap_title">Toque para abrir</string>
    <string name="onb_tap_body">Toque na ilha pequena para ir direto ao app.</string>
    <string name="onb_hold_title">Segure para expandir</string>
    <string name="onb_hold_body">Toque e segure, ou puxe para baixo, para abrir o cartão completo com os controles.</string>
    <string name="onb_up_title">Deslize para cima para recolher</string>
    <string name="onb_up_body">Deslize para cima em um cartão aberto para encolhê-lo. Tocar fora dele também funciona.</string>
    <string name="onb_side_title">Duas ao mesmo tempo</string>
    <string name="onb_side_body">Quando duas coisas estão ativas, a segunda espera em uma bolha. Deslize para o lado para trocá-las ou segure a bolha para abri-la.</string>
    <string name="onb_volume_title">Volume, alarmes e mais</string>
    <string name="onb_volume_body">Teclas de volume, fones, downloads e alarmes ganham ilhas próprias. Ative ou desative cada uma em Recursos.</string>
    <string name="onb_finish_title">Conecte sua ilha</string>
    <string name="onb_finish_body">Dê ao Dynamic Droid acesso às notificações e a sobreposição da área da câmera, e sua ilha ganha vida.</string>
    <string name="onb_ready_title">Tudo pronto</string>
    <string name="onb_ready_body">Sua ilha está conectada. Reveja este tour quando quiser em Testar.</string>
    <string name="feature_hide_popups">Ocultar as notificações pop-up do celular</string>
    <string name="feature_hide_popups_note">A ilha mostra as novas notificações no lugar dos banners do celular. Elas continuam chegando na aba de notificações. Os pop-ups voltam sozinhos quando a ilha não está ativa, no horário silencioso ou se o acesso às notificações for perdido.</string>
    <string name="popups_status_active">Ativo • os pop-ups do celular ficam ocultos enquanto a ilha funciona</string>
    <string name="popups_status_waiting">Ligado • os pop-ups somem quando a ilha e o acesso às notificações estiverem conectados</string>
    <string name="popups_status_needs_grant">Precisa de uma permissão única pelo computador</string>
    <string name="popups_grant_button">Como permitir</string>
    <string name="popups_grant_title">Permitir controle dos pop-ups</string>
    <string name="popups_grant_body">O Android só deixa apps mudarem essa configuração após uma permissão única. Ative a depuração USB, conecte o celular a um computador e execute:\n\n%1$s\n\nDesative esta opção antes de desinstalar o Dynamic Droid para os pop-ups voltarem.</string>
